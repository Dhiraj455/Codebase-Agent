# Backend Environment Variables
# Copy this file to .env and fill in your values

# Google Gemini API Key (required for LLM features)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Configuration
BACKEND_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Paths
VECTOR_STORE_PATH=./vector_store
REPO_CACHE_DIR=./repos

# Google Gemini Model (optional, defaults to gemini-2.0-flash-exp)
# Options: gemini-2.0-flash-exp, gemini-1.5-flash, gemini-1.5-pro, gemini-pro
# Note: gemini-2.0-flash-exp is the latest experimental model
GEMINI_MODEL=gemini-2.0-flash-exp

# CORS Origins (comma-separated, optional)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001
